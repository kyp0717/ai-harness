{
  "name": "ai-harness-deployment",
  "private": true,
  "version": "1.0.0",
  "description": "DeepSeek Harness (dsh) deployment configuration: Kimi Code integration setup script, pinned vendor packages, and operator docs for keeping two machines in parity.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-kimi.mjs",
    "setup:dry": "node scripts/setup-kimi.mjs --dry-run",
    "setup:doctor": "node scripts/setup-kimi.mjs --dry-run --verbose",
    "bridge": "node scripts/bridge-kimi-token.mjs",
    "bridge:verify": "node scripts/bridge-kimi-token.mjs --verify",
    "bridge:dry": "node scripts/bridge-kimi-token.mjs --dry-run",
    "kimi-login": "node scripts/kimi-login.mjs",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:dry": "node scripts/install-skills.mjs --dry-run",
    "skills:import": "node scripts/import-skills.mjs",
    "skills:import:pstack": "node scripts/import-skills.mjs 'https://github.com/poteto/plugins#pstack'"
  },
  "engines": {
    "node": ">=18"
  }
}
